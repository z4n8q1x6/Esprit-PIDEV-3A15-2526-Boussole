<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<div class="container-fluid p-4">
    <div class="card bg-dark text-white border-0 shadow">
        <div class="card-header border-secondary bg-transparent d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-0"><i class="fas fa-file-pdf text-danger me-2"></i>Archives des Rapports</h2>
                <small class="text-muted">Instantanés PDF des alertes système (Cloudinary)</small>
            </div>
            <a href="{{ path('admin_alerte_index') }}" class="btn btn-outline-light btn-sm">
                <i class="fas fa-arrow-left"></i> Retour aux Alertes
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle" id="reports-table">
                    <thead class="text-secondary text-uppercase small">
                        <tr>
                            <th>Date de Génération</th>
                            <th>Volume</th>
                            <th>Statut</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for report in reports %}
                            <tr id="report-row-{{ report.id }}">
                                <td>
                                    <div class="fw-bold">{{ report.generatedAt|date('d/m/Y') }}</div>
                                    <div class="small text">{{ report.generatedAt|date('H:i') }}</div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-info text-dark">
                                        {{ report.alertCount }} alertes
                                    </span>
                                </td>
                                <td>
                                    <span class="text-success small"><i class="fas fa-check-circle"></i> Stocké</span>
                                </td>
                                <td class="text-end">
                                    {# Preview Button #}
                                    <button class="btn btn-sm btn-primary"
                                            onclick="previewPdf('{{ report.url }}')"
                                            data-bs-toggle="modal"
                                            data-bs-target="#pdfModal">
                                        <i class="fas fa-eye"></i> Aperçu
                                    </button>

                                    {# Download Button #}
                                    <a href="{{ report.url }}" download="Rapport_{{ report.generatedAt|date('Y-m-d') }}.pdf" class="btn btn-sm btn-outline-secondary ms-1">
                                        <i class="fas fa-download"></i>
                                    </a>

<button type="button"
        class="btn btn-sm btn-danger mb-0 delete-report-btn"
        style="width: 2rem; height: 2rem; padding: 0; display: inline-flex; align-items: center; justify-content: center;"
        data-bs-toggle="modal"
        data-bs-target="#deleteReportModal"
        data-report-id="{{ report.id }}"
        data-delete-url="{{ path('admin_alert_report_delete', {'id': report.id}) }}"
        data-item-name="Rapport du {{ report.generatedAt|date('d/m/Y à H:i') }}"
        data-csrf-token="{{ csrf_token('delete-report') }}">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
    </svg>
</button>
                                </td>
                            </tr>
                        {% else %}
                            <tr id="no-reports-row">
                                <td colspan="4" class="text-center py-5 text-muted">
                                    Aucun rapport archivé pour le moment.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# PDF Preview Modal #}
<div class="modal fade" id="pdfModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white">Visualisation du Rapport</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="height: 80vh;">
                <iframe id="pdfFrame" src="" width="100%" height="100%" frameborder="0"></iframe>
            </div>
        </div>
    </div>
</div>

{# Delete Confirmation Modal — exact same structure & colors as index.html.twig #}
<div class="modal fade" id="deleteReportModal" tabindex="-1" aria-labelledby="deleteReportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title fw-600" id="deleteReportModalLabel">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="mb-3">
                    <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
                </div>
                <p class="text-muted mb-2">Êtes-vous sûr de vouloir supprimer ?</p>
                <p class="fw-600 text-dark" id="deleteReportItemName"></p>
                <p class="text-muted small mb-0">Le fichier PDF sera également supprimé du cloud.</p>
            </div>
            <div class="modal-footer bg-light border-top-0 gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteReportBtn">
                    <span id="deleteReportBtnText">Supprimer</span>
                    <span id="deleteReportSpinner" class="spinner-border spinner-border-sm ms-1 d-none" role="status"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
// PDF preview
function previewPdf(url) {
    const pdfFrame = document.getElementById('pdfFrame');
    pdfFrame.src = "";
    pdfFrame.src = `https://docs.google.com/viewer?url=${encodeURIComponent(url)}&embedded=true`;
}

// Delete report — AJAX
document.addEventListener('DOMContentLoaded', function () {
    // Create a reusable modal instance once (avoids getInstance() returning null)
    const deleteModalEl  = document.getElementById('deleteReportModal');
    const deleteModalObj = new bootstrap.Modal(deleteModalEl);

    let currentDeleteUrl  = null;
    let currentCsrfToken  = null;
    let currentReportId   = null;

    document.querySelectorAll('.delete-report-btn').forEach(function (button) {
        button.addEventListener('click', function () {
            currentDeleteUrl = this.dataset.deleteUrl;
            currentCsrfToken = this.dataset.csrfToken;
            currentReportId  = this.dataset.reportId;
            document.getElementById('deleteReportItemName').textContent = this.dataset.itemName;
        });
    });

    document.getElementById('confirmDeleteReportBtn').addEventListener('click', function () {
        if (!currentDeleteUrl || !currentCsrfToken) return;

        // Show loading state
        const btn = document.getElementById('confirmDeleteReportBtn');
        document.getElementById('deleteReportBtnText').textContent = 'Suppression…';
        document.getElementById('deleteReportSpinner').classList.remove('d-none');
        btn.disabled = true;

        fetch(currentDeleteUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'token=' + encodeURIComponent(currentCsrfToken),
        })
        .then(function (response) {
            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }
            return response.json();
        })
        .then(function (data) {
            if (data.success) {
                // Hide modal first, then remove the row
                deleteModalObj.hide();

                const row = document.getElementById('report-row-' + currentReportId);
                if (row) row.remove();

                // Show empty-state row if no more reports
                const tbody = document.getElementById('reports-table').querySelector('tbody');
                if (tbody && tbody.querySelectorAll('tr[id^="report-row-"]').length === 0) {
                    const emptyRow = document.createElement('tr');
                    emptyRow.id = 'no-reports-row';
                    emptyRow.innerHTML = '<td colspan="4" class="text-center py-5 text-muted">Aucun rapport archivé pour le moment.</td>';
                    tbody.appendChild(emptyRow);
                }
            } else {
                deleteModalObj.hide();
                alert('Erreur : ' + (data.error || 'La suppression a échoué.'));
            }
        })
        .catch(function (err) {
            deleteModalObj.hide();
            alert('Une erreur réseau est survenue : ' + err.message);
        })
        .finally(function () {
            document.getElementById('deleteReportBtnText').textContent = 'Supprimer';
            document.getElementById('deleteReportSpinner').classList.add('d-none');
            document.getElementById('confirmDeleteReportBtn').disabled = false;
        });
    });
});
</script>
