{% extends 'front_base.html.twig' %}

{% block title %}Modifier le Prêt #{{ pret.id }} - Boussole{% endblock %}

{% block content %}

<div class="container-fluid mt-4">
    <!-- Titre de la page avec le style du thème -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0">Modifier le Prêt #{{ pret.id }}</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-dots mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('app_front_home') }}">Accueil</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_pret_index') }}">Prêts</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_pret_show', {'id': pret.id}) }}">Détails #{{ pret.id }}</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Modifier</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <!-- Carte du formulaire -->
        <div class="col-12">
            <div class="card border rounded-3">
                <!-- Card header -->
                <div class="card-header border-bottom bg-light d-flex justify-content-between align-items-center">
                    <h5 class="card-header-title mb-0">Modification de la demande de prêt</h5>
                    <a href="{{ path('app_pret_show', {'id': pret.id}) }}" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-eye me-1"></i>Voir détails
                    </a>
                </div>

                <!-- Card body -->
                <div class="card-body">
                    {{ include('pret/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
