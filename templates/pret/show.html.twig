{% extends 'front_base.html.twig' %}

{% block title %}Détails du Prêt #{{ pret.id }} - Boussole{% endblock %}

{% block content %}

<div class="container-fluid mt-4">
    <!-- Titre de la page avec le style du thème -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0">Détails du Prêt #{{ pret.id }}</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-dots mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('app_front_home') }}">Accueil</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_pret_index') }}">Prêts</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Détails #{{ pret.id }}</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <!-- Informations du prêt -->
        <div class="col-lg-8">
            <div class="card border rounded-3">
                <!-- Card header -->
                <div class="card-header border-bottom bg-light d-flex justify-content-between align-items-center">
                    <h5 class="card-header-title mb-0">Informations de la demande</h5>
                    <div class="btn-group" role="group">
                        <a href="{{ path('app_pret_edit', {'id': pret.id}) }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i>Modifier
                        </a>
                        {{ include('pret/_delete_form.html.twig') }}
                    </div>
                </div>

                <!-- Card body -->
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <div class="text-muted small mb-1">Montant demandé</div>
                                <div class="h4 mb-0 text-primary">{{ pret.montantDemande|number_format(0, ',', ' ') }} TND</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <div class="text-muted small mb-1">Durée</div>
                                <div class="h4 mb-0">{{ pret.dureeMois }} mois</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <div class="text-muted small mb-1">Taux d'intérêt</div>
                                <div class="h4 mb-0">{{ pret.taux }}%</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <div class="text-muted small mb-1">Statut</div>
                                <div class="h4 mb-0">
                                    {% if pret.statut == 'APPROUVE' %}
                                        <span class="badge bg-success fs-6">Approuvé</span>
                                    {% elseif pret.statut == 'REFUSE' %}
                                        <span class="badge bg-danger fs-6">Refusé</span>
                                    {% elseif pret.statut == 'EN_ATTENTE' %}
                                        <span class="badge bg-warning fs-6">En attente</span>
                                    {% else %}
                                        <span class="badge bg-secondary fs-6">{{ pret.statut }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="border rounded p-3">
                                <div class="text-muted small mb-2">Motif de la demande</div>
                                <div class="">{{ pret.motif }}</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <div class="text-muted small mb-1">Date de demande</div>
                                <div class="mb-3">{{ pret.dateDemande ? pret.dateDemande|date('d/m/Y à H:i') : '' }}</div>
                                
                                <!-- Partie ajoutée : Formulaire Stripe -->
                                <form action="{{ path('app_stripe_checkout', {'id': pret.id}) }}" method="POST">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bi bi-credit-card me-2"></i>Payer les frais de dossier (50 TND)
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded p-3">
                                <div class="text-muted small mb-1">Franchise</div>
                                <div class="">Franchise #{{ pret.franchiseId.id }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions rapides -->
        <div class="col-lg-4">
            <div class="card border rounded-3">
                <div class="card-header border-bottom bg-light">
                    <h5 class="card-header-title mb-0">Actions rapides</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ path('app_pret_index') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Retour à la liste
                        </a>
                        <a href="{{ path('app_pret_new') }}" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-2"></i>Nouvelle demande
                        </a>
                        <a href="{{ path('app_pret_simulation') }}" class="btn btn-info">
                            <i class="bi bi-calculator me-2"></i>Simuler un prêt
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}